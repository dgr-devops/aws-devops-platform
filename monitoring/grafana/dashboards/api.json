{
  "title": "API", "uid": "api-overview", "schemaVersion": 39, "refresh": "10s",
  "time": {"from": "now-30m", "to": "now"},
  "panels": [
    {"id": 1, "type": "timeseries", "title": "Peticiones por segundo", "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"expr": "sum by (status) (rate(http_requests_total{job=\"api\"}[1m]))", "legendFormat": "{{status}}"}]},
    {"id": 2, "type": "timeseries", "title": "Latencia p95", "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"api\"}[5m])))", "legendFormat": "p95"}]}
  ]
}
